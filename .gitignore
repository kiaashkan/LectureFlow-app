app/src/main/res/mipmap-*/ic_launcher.png
app/src/main/res/mipmap-*/ic_maskable.png
app/src/main/res/drawable-*/splash.png
app/src/main/res/drawable-night-*/splash.png
app/src/main/res/drawable-*/ic_notification_icon.png
store_icon.png

# Manual-build working files (dependency cache is re-downloadable)
manual-build/work/
manual-build/deps/
__pycache__/
